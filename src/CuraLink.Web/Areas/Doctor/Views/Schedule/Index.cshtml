@model ScheduleIndexViewModel
@{
    ViewData["Title"] = "Schedule";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Weekly schedule</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-navy" asp-area="Doctor" asp-controller="Schedule" asp-action="Exceptions">
            <i class="bi bi-calendar-x"></i> Exceptions
        </a>
        <a class="btn btn-navy" asp-area="Doctor" asp-controller="Schedule" asp-action="Add">
            <i class="bi bi-plus-lg"></i> Add schedule
        </a>
    </div>
</div>

<div class="card card-shadow mb-4">
    <div class="card-header bg-white"><h2 class="h6 mb-0">Recurring hours</h2></div>
    <div class="card-body p-0">
        @if (Model.Schedules is null || !Model.Schedules.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-calendar-week"></i>
                No recurring schedule has been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Slot</th>
                            <th>Active</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>@schedule.DayOfWeek</td>
                                <td>@schedule.StartTime.ToString(@"hh\:mm")</td>
                                <td>@schedule.EndTime.ToString(@"hh\:mm")</td>
                                <td>@schedule.SlotDurationMinutes min</td>
                                <td>
                                    @if (schedule.IsActive)
                                    {
                                        <span class="status-badge status-Confirmed">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-Cancelled">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-navy" asp-area="Doctor" asp-controller="Schedule" asp-action="Edit" asp-route-id="@schedule.Id">Edit</a>
                                    <form asp-area="Doctor" asp-controller="Schedule" asp-action="Delete" asp-route-id="@schedule.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this schedule?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (Model.Exceptions is not null && Model.Exceptions.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <a asp-area="Doctor" asp-controller="Schedule" asp-action="Exceptions">
                                        @Model.Exceptions.Count date exception(s) configured
                                    </a>
                                </td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
