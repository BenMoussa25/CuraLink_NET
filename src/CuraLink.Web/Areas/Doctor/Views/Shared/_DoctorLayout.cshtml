<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CuraLink Doctor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <div class="doctor-shell">
        <aside class="doctor-sidebar">
            <div class="sidebar-brand"><i class="bi bi-heart-pulse"></i> CuraLink</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="Doctor" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Profile" ? "active" : "")" asp-area="Doctor" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-badge"></i> My profile
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Schedule" ? "active" : "")" asp-area="Doctor" asp-controller="Schedule" asp-action="Index">
                        <i class="bi bi-calendar-week"></i> Schedule
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Appointments" ? "active" : "")" asp-area="Doctor" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar2-check"></i> Appointments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Patients" ? "active" : "")" asp-area="Doctor" asp-controller="Patients" asp-action="Index">
                        <i class="bi bi-people"></i> Patients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Consultations" ? "active" : "")" asp-area="Doctor" asp-controller="Consultations" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Consultations
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Prescriptions" ? "active" : "")" asp-area="Doctor" asp-controller="Prescriptions" asp-action="Index">
                        <i class="bi bi-capsule"></i> Prescriptions
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Documents" ? "active" : "")" asp-area="Doctor" asp-controller="Documents" asp-action="Index">
                        <i class="bi bi-folder2-open"></i> Documents
                    </a>
                </li>
                <li class="nav-item mt-3">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left"></i> Public site
                    </a>
                </li>
            </ul>
        </aside>

        <div class="doctor-main">
            <header class="doctor-topbar d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="text-muted small">Doctor portal</span>
                    <div class="fw-semibold text-navy">@ViewData["Title"]</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="small text-muted">
                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                    </span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-navy btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Sign out
                        </button>
                    </form>
                </div>
            </header>

            <main class="doctor-content">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle"></i> @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
