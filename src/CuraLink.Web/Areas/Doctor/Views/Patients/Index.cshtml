@model IReadOnlyList<PatientSummaryDto>
@{
    ViewData["Title"] = "Patients";
}

<h1 class="h3 mb-4">Patients</h1>

<div class="card card-shadow">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Your patients</h2>
        <span class="text-muted small">@Model.Count total</span>
    </div>
    <div class="card-body p-0">
        @if (Model is null || !Model.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-people"></i>
                No patients have been assigned to you yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>Appointments</th>
                            <th>Last visit</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>@patient.FullName</td>
                                <td>@patient.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(patient.City) ? "-" : patient.City)</td>
                                <td>@patient.AppointmentCount</td>
                                <td>@TimeZoneHelper.Format(patient.LastAppointmentUtc, AppTimeZone)</td>
                                <td>
                                    <a asp-area="Doctor" asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
