@model DoctorDashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Good day, doctor</h1>
        <p class="text-muted mb-0">A quick view of your practice.</p>
    </div>
    <a class="btn btn-navy" asp-area="Doctor" asp-controller="Appointments" asp-action="Index">
        <i class="bi bi-calendar2-check"></i> All appointments
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-shadow stat-card">
            <div class="card-body">
                <div class="text-muted small">Today's appointments</div>
                <div class="stat-value">@Model.TodayAppointmentCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-shadow stat-card">
            <div class="card-body">
                <div class="text-muted small">Pending requests</div>
                <div class="stat-value">@Model.PendingRequestCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-shadow stat-card">
            <div class="card-body">
                <div class="text-muted small">Upcoming appointments</div>
                <div class="stat-value">@Model.UpcomingAppointmentCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-shadow stat-card">
            <div class="card-body">
                <div class="text-muted small">Patients</div>
                <div class="stat-value">@Model.PatientCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card card-shadow mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Today's appointments</h2>
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="Index">Manage schedule</a>
    </div>
    <div class="card-body p-0">
        @if (Model.TodayAppointments is null || !Model.TodayAppointments.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-calendar-x"></i>
                No appointments scheduled for today.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.TodayAppointments)
                        {
                            <tr>
                                <td>@TimeZoneHelper.Format(appointment.StartAtUtc, AppTimeZone)</td>
                                <td>@appointment.PatientName</td>
                                <td><span class="status-badge status-@appointment.Status">@appointment.Status</span></td>
                                <td>
                                    <a asp-area="Doctor" asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card card-shadow">
    <div class="card-header bg-white">
        <h2 class="h6 mb-0">Pending requests</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.PendingRequests is null || !Model.PendingRequests.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-inbox"></i>
                No pending appointment requests.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Requested</th>
                            <th>Patient</th>
                            <th>Time</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.PendingRequests)
                        {
                            <tr>
                                <td>@TimeZoneHelper.Format(request.CreatedAtUtc, AppTimeZone)</td>
                                <td>@request.PatientName</td>
                                <td>@TimeZoneHelper.Format(request.StartAtUtc, AppTimeZone)</td>
                                <td>
                                    <a asp-area="Doctor" asp-controller="Appointments" asp-action="Details" asp-route-id="@request.Id">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
