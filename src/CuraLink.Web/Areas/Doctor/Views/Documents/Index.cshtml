@model IReadOnlyList<MedicalDocumentDto>
@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Documents</h1>
    <a class="btn btn-navy" asp-area="Doctor" asp-controller="Documents" asp-action="Upload">
        <i class="bi bi-upload"></i> Upload document
    </a>
</div>

<div class="card card-shadow">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Shared and uploaded files</h2>
        <span class="text-muted small">@Model.Count total</span>
    </div>
    <div class="card-body p-0">
        @if (Model is null || !Model.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-folder2-open"></i>
                No documents are available yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Uploaded</th>
                            <th>Patient</th>
                            <th>File</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Visibility</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Model)
                        {
                            <tr>
                                <td>@TimeZoneHelper.Format(document.UploadedAtUtc, AppTimeZone)</td>
                                <td>@document.PatientName</td>
                                <td>@document.OriginalFileName</td>
                                <td>@document.DocumentType</td>
                                <td>@(document.FileSizeBytes / 1024) KB</td>
                                <td><span class="status-badge status-@document.VisibilityStatus">@document.VisibilityStatus</span></td>
                                <td>
                                    <a asp-area="Doctor" asp-controller="Documents" asp-action="Download" asp-route-id="@document.Id">Download</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
