@model PrescriptionDto
@{
    ViewData["Title"] = "Prescription details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Prescription details</h1>
        <p class="text-muted mb-0">@Model.PatientName &middot; @TimeZoneHelper.Format(Model.IssuedAtUtc, AppTimeZone)</p>
    </div>
    <a class="btn btn-outline-navy" asp-area="Doctor" asp-controller="Prescriptions" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to list
    </a>
</div>

<div class="card card-shadow mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Medicines</h2>
        <span class="status-badge status-@Model.Status">@Model.Status</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Items is null || !Model.Items.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-capsule"></i>
                No medicines were recorded for this prescription.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th>Strength</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                            <th>Route</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.MedicineName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Strength) ? "-" : item.Strength)</td>
                                <td>@item.DosageInstructions</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Frequency) ? "-" : item.Frequency)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Duration) ? "-" : item.Duration)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Route) ? "-" : item.Route)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.AdditionalInstructions) ? "-" : item.AdditionalInstructions)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card card-shadow">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">General instructions</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.GeneralInstructions) ? "-" : Model.GeneralInstructions)</dd>
            <dt class="col-sm-3">Shared with patient</dt>
            <dd class="col-sm-9">@(Model.IsSharedWithPatient ? "Yes" : "No")</dd>
        </dl>
        @if (Model.Status == PrescriptionStatus.Issued)
        {
            <form asp-area="Doctor" asp-controller="Prescriptions" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3">
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Cancel this prescription?');">
                    <i class="bi bi-x-circle"></i> Cancel prescription
                </button>
            </form>
        }
    </div>
</div>
