@model IReadOnlyList<PrescriptionDto>
@{
    ViewData["Title"] = "Prescriptions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Prescriptions</h1>
    <a class="btn btn-navy" asp-area="Doctor" asp-controller="Prescriptions" asp-action="Create">
        <i class="bi bi-plus-lg"></i> New prescription
    </a>
</div>

<div class="card card-shadow">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">All prescriptions</h2>
        <span class="text-muted small">@Model.Count total</span>
    </div>
    <div class="card-body p-0">
        @if (Model is null || !Model.Any())
        {
            <div class="empty-state m-3">
                <i class="bi bi-capsule"></i>
                No prescriptions have been issued yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Issued</th>
                            <th>Patient</th>
                            <th>Items</th>
                            <th>Status</th>
                            <th>Shared</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prescription in Model)
                        {
                            <tr>
                                <td>@TimeZoneHelper.Format(prescription.IssuedAtUtc, AppTimeZone)</td>
                                <td>@prescription.PatientName</td>
                                <td>@(prescription.Items is null ? 0 : prescription.Items.Count)</td>
                                <td><span class="status-badge status-@prescription.Status">@prescription.Status</span></td>
                                <td>@(prescription.IsSharedWithPatient ? "Yes" : "No")</td>
                                <td>
                                    <a asp-area="Doctor" asp-controller="Prescriptions" asp-action="Details" asp-route-id="@prescription.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
