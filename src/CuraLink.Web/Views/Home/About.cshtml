@{
    ViewData["Title"] = "About";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h2">About CuraLink</h1>
        <p class="lead">
            CuraLink is a web platform designed to make everyday healthcare coordination simpler and clearer.
        </p>
        <p>
            Patients can request appointments and keep their records in one place. Doctors can manage their
            schedules, review requests, document consultations, issue prescriptions and share documents securely.
        </p>
        <p>
            Access to clinical information is limited by role and ownership, so each doctor only sees the patients
            they are responsible for.
        </p>
        <a class="btn btn-outline-navy" asp-area="" asp-controller="Home" asp-action="Contact">Get in touch</a>
    </div>
</div>
