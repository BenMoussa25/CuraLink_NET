@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h2">@ViewData["Title"]</h1>
        <p>
            CuraLink stores only the information needed to provide care coordination: account details,
            appointment data and clinical records created by authorized users.
        </p>
        <p>
            Clinical data is visible only to the patient it belongs to and to doctors with a legitimate
            care relationship. Doctor and patient profiles are never used for advertising.
        </p>
        <p>
            Uploaded files are kept in private storage and are served only through authorized application actions.
        </p>
    </div>
</div>
