@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-5">
                <i class="bi bi-exclamation-octagon fs-1 text-danger"></i>
                <h1 class="h3 mt-3">Something went wrong</h1>
                <p class="text-muted">An error occurred while processing your request.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
                }
                <a class="btn btn-navy mt-2" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
        </div>
    </div>
</div>
